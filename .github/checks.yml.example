# To enable CI, publish this file as .github/workflows/checks.yml using an
# account or token allowed to create GitHub Actions workflows.
name: Checks

on:
  push:
  pull_request:

permissions:
  contents: read

concurrency:
  group: checks-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  package:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: "3.14"
          cache: pip
          cache-dependency-path: requirements-dev.txt
      - name: Install development tools
        run: python -m pip install -r requirements-dev.txt
      - name: Lint and check formatting
        run: |
          ruff check .
          ruff format --check .
      - name: Build source and wheel distributions
        run: python -m build
      - name: Install the built wheel
        run: python -m pip install --no-deps dist/*.whl
      - name: Verify installed package outside the source checkout
        working-directory: ${{ runner.temp }}
        run: |
          python -c "from importlib.metadata import version; import allimquran.hooks; print(version('allimquran'))"
