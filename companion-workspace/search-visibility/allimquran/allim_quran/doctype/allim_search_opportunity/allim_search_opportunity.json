{
  "doctype": "DocType",
  "name": "ALLIM Search Opportunity",
  "module": "ALLIM Quran",
  "autoname": "format:ALLIM-SEO-{#####}",
  "title_field": "route",
  "track_changes": 1,
  "sort_field": "last_seen",
  "sort_order": "DESC",
  "field_order": ["route", "channel", "priority", "status", "issue_code", "issue", "recommendation", "stable_key", "last_seen"],
  "fields": [
    {"fieldname": "route", "label": "Route", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "channel", "label": "Channel", "fieldtype": "Select", "options": "SEO\nGEO\nAEO", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "priority", "label": "Priority", "fieldtype": "Select", "options": "Critical\nHigh\nMedium\nLow", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Open\nPlanned\nIn progress\nResolved\nDismissed", "default": "Open", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "issue_code", "label": "Issue Code", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "issue", "label": "Finding", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "recommendation", "label": "Recommended Action", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "stable_key", "label": "Stable Key", "fieldtype": "Data", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "last_seen", "label": "Last Seen", "fieldtype": "Datetime", "reqd": 1, "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Website Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1}
  ]
}
