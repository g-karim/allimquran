{
  "doctype": "DocType",
  "name": "ALLIM Search Prompt",
  "module": "ALLIM Quran",
  "autoname": "format:ALLIM-PROMPT-{#####}",
  "title_field": "prompt_text",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": ["prompt_text", "stable_key", "language", "market", "audience", "journey_stage", "target_route", "active", "measurement_status", "last_measured"],
  "fields": [
    {"fieldname": "prompt_text", "label": "Prompt", "fieldtype": "Small Text", "reqd": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "stable_key", "label": "Stable Key", "fieldtype": "Data", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "language", "label": "Language", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "market", "label": "Market", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "audience", "label": "Audience", "fieldtype": "Data"},
    {"fieldname": "journey_stage", "label": "Journey Stage", "fieldtype": "Select", "options": "Awareness\nConsideration\nDecision\nRetention", "in_standard_filter": 1},
    {"fieldname": "target_route", "label": "Target Route", "fieldtype": "Data"},
    {"fieldname": "active", "label": "Active", "fieldtype": "Check", "default": "1", "in_list_view": 1},
    {"fieldname": "measurement_status", "label": "Measurement Status", "fieldtype": "Select", "options": "Not measured\nQueued\nMeasured\nFailed", "default": "Not measured", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "last_measured", "label": "Last Measured", "fieldtype": "Datetime", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Website Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1}
  ]
}
